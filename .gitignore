# Generated files
.quarto/
_site/

# docs/ is the published GitHub Pages output (now a static redirect) and must stay
# tracked. The global ~/.gitignore ignores *.html, which would silently drop the
# redirect's 404.html. Re-include the docs/ output so the redirect deploys in full.
!docs/**
# still ignore stray HTML/PDF rendered at the repo root
/*.html
/*.pdf
*.pptx
*.zip
*.tar.gz

# R/RStudio files
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log
.last-update

# Jupyter
.ipynb_checkpoints/

# Node
node_modules/
package-lock.json
/.quarto/

**/*.quarto_ipynb
